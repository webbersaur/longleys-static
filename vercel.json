{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "longleys-static.vercel.app"
        }
      ],
      "destination": "https://longleysct.com/$1",
      "permanent": true
    },
    {
      "source": "/catering/",
      "destination": "/catering-menu/",
      "permanent": true
    },
    {
      "source": "/off-premise-catering-2/",
      "destination": "/off-premise-catering/",
      "permanent": true
    },
    {
      "source": "/about-us/",
      "destination": "/why-locals-love-longleys/",
      "permanent": true
    },
    {
      "source": "/did-somebody-say-homemade/",
      "destination": "/menu/",
      "permanent": true
    },
    {
      "source": "/happy/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/not-happy/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/thank-you/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
